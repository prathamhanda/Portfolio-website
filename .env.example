# -----------------------------------------------------------------------------
# Environment variables
# Copy to .env.local and fill in.  .env.local is git-ignored.
# -----------------------------------------------------------------------------

## SERVER-SIDE ONLY (never exposed to the browser)
##
## IMPORTANT: these must NOT use the VITE_ prefix.
## Any variable named VITE_* is inlined into the public JavaScript bundle by
## Vite and is readable by anyone via DevTools -> Network / Sources.
##
## Local development: .env.local is enough (the Vite dev plugin runs api/chat.js).
## Production: add this in the Vercel dashboard under
##   Project -> Settings -> Environment Variables, and tick all three
##   environments (Production / Preview / Development).

# One key, or several separated by commas for round-robin failover.
GEMINI_API_KEYS=

# Optional: pin a specific model instead of the built-in fallback chain.
# Leave unset to use gemini-3.5-flash-lite -> 3.1-flash-lite -> 3.6-flash -> 3.8-flash
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: cache lifetime for /api/github-contribs, in seconds (default 600)
# GH_CONTRIBS_CACHE_TTL_SECONDS=600


## PUBLIC (safe to expose, Vite inlines these into the client bundle)
## These are usernames only, not secrets.

VITE_LEETCODE_USERNAME=prathamhanda
VITE_GITHUB_USERNAME=prathamhanda

# Only needed by the GitHub Actions stats workflows:
# VITE_CODEFORCES_USERNAME=prathamhanda10
# VITE_CODECHEF_USERNAME=prathamhanda
# VITE_GFG_USERNAME=prathamh